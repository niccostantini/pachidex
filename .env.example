# ============================================================================
# Supabase — Project Settings > API
# Pubbliche apposta: finiscono nel bundle client, protette dalle RLS.
# ============================================================================
PUBLIC_SUPABASE_URL="https://xxxxxxxxxxxx.supabase.co"
PUBLIC_SUPABASE_ANON_KEY="eyJhbGciOi..."

# ============================================================================
# Cloudflare R2 — SOLO server, mai prefissate PUBLIC_.
# SvelteKit lo impone a livello di build: importarle da un file client non
# compila nemmeno. Su Vercel vanno messe come variabili d'ambiente normali
# (non serve altro), il framework le tiene fuori dal bundle da solo.
#
# Una di queste, la secret access key, e' una credenziale vera: chi la
# ottiene puo' scrivere e CANCELLARE l'intero bucket. Non deve mai finire
# in un file committato, in un log, o in una variabile PUBLIC_.
# ============================================================================

# Cloudflare dashboard > barra laterale, in fondo a destra sotto "Account ID"
R2_ACCOUNT_ID="xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# R2 > Manage API Tokens > Create API Token > permessi "Object Read & Write"
# ristretti al bucket qui sotto. Le API Keys S3 di R2 sono cosa diversa dal
# Global API Key dell'account: servono queste, non quella.
R2_ACCESS_KEY_ID="xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
R2_SECRET_ACCESS_KEY="xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# Il nome del bucket, creato una volta sola dal pannello R2
R2_BUCKET="pachidex"

# Giurisdizione del bucket. R2 ha endpoint separati per giurisdizione e un
# bucket EU NON risponde da quello standard: da' AccessDenied, che sembra
# tale e quale a una chiave sbagliata. Lo vedi nel pannello R2 accanto al
# nome del bucket ("EU" oppure niente).
#   bucket con giurisdizione EU  -> "eu"
#   bucket standard              -> lascia vuoto
R2_JURISDICTION="eu"

# Il dominio da cui le foto si leggono in pubblico: R2 > il tuo bucket >
# Settings > Custom Domains > Connect Domain (serve un dominio gia' su
# Cloudflare DNS). Senza slash finale.
R2_PUBLIC_BASE_URL="https://cdn.tuodominio.it"

# ============================================================================
# Web Push — notifiche PWA
# Le chiavi VAPID si generano una volta sola:
#   node -e "console.log(require('web-push').generateVAPIDKeys())"
# La pubblica finisce nel bundle client (deve, serve al browser per iscriversi);
# la privata firma gli invii e resta solo lato server.
# ============================================================================
PUBLIC_VAPID_KEY="B..."
VAPID_PRIVATE_KEY="..."
VAPID_SUBJECT="mailto:tu@tuodominio.it"

# Segreto che pg_cron passa all'endpoint delle notifiche a orario, cosi' non
# puo' chiamarlo chiunque. Generane uno a caso:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
CRON_SECRET="..."
